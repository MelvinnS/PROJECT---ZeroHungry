# Kunci gratis dari https://aistudio.google.com/apikey (tanpa kartu kredit). Kosongkan untuk memakai Mode Contoh.
GEMINI_API_KEY=ISI_API_KEY_DI_SINI
# Opsional: ganti model tanpa mengubah kode
GEMINI_MODEL=gemini-2.5-flash
# Opsional: daftar rantai model dipisah koma (failover otomatis jika model pertama gagal)
GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.5-flash
# Set true untuk memaksa Mode Contoh walau API key ada
FORCE_FALLBACK=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
